{
  "name": "tuitionforhome",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "prisma db push --accept-data-loss && node prisma/seed.js",
    "dev": "next dev",
    "build": "prisma generate && prisma db push --accept-data-loss && node prisma/seed.js && next build",
    "prestart": "prisma db push --accept-data-loss && node prisma/seed.js",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --accept-data-loss",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "cloudinary": "^2.10.0",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.428.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.14.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.24",
    "prisma": "^5.18.0",
    "typescript": "^5.5.4"
  }
}

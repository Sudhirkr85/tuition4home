# Database (MySQL)
DATABASE_URL="mysql://root:1234@localhost:3306/tuitionforhome"

# NextAuth Authentication & Master Encryption
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"
ENCRYPTION_KEY="your_encryption_key_here"
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Brevo Email Service (OTP & Transactional Alerts)
BREVO_API_KEY="your_brevo_api_key_here"
BREVO_SENDER_EMAIL="support@tuitionforhome.com"
BREVO_SENDER_NAME="TuitionForHome Support"

# Cloudinary (Media, Videos & Private KYC Documents)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
CLOUDINARY_URL="cloudinary://<key>:<secret>@<cloud_name>"

# Google Maps API (JavaScript, Geocoding & Places)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# Telegram Bot (Internal Staff Lead Alerts)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Firebase Cloud Messaging (Web Push Notifications)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key_here"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tuitionforhome"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id_here"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id_here"
